<svg xmlns="http://www.w3.org/2000/svg" width="2400" height="2640" viewBox="0 0 2400 2640"><defs><marker id="arrow" viewBox="0 0 12 12" markerWidth="20" markerHeight="20" markerUnits="userSpaceOnUse" refX="11" refY="6" orient="auto"><path d="M0,0 L12,6 L0,12 z" fill="context-stroke"/></marker></defs><rect x="0" y="0" width="2400" height="2640" rx="0" fill="#f8fbff" stroke="none" stroke-width="2"/><text x="1200" y="62" font-family="Arial,Helvetica,sans-serif" font-size="48" font-weight="800" fill="#06245c" text-anchor="middle">Fluxo Operacional do Aplicativo</text><text x="1200" y="105" font-family="Arial,Helvetica,sans-serif" font-size="25" font-weight="500" fill="#294267" text-anchor="middle">TESOURARIA FM NOVO — Despesas, Receitas, Repasses, Comissões, Repasse Societário e DRE</text><rect x="40" y="130" width="2320" height="92" rx="16" fill="#ffffff" stroke="#d7e3f4" stroke-width="2"/><text x="70" y="168" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="800" fill="#06245c" text-anchor="start">Responsáveis</text><circle cx="82" cy="196" r="10" fill="#0b7a3b"/><text x="102" y="192" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="800" fill="#0b7a3b" text-anchor="start">Fernando (Master)</text><text x="102" y="214" font-family="Arial,Helvetica,sans-serif" font-size="18" font-weight="500" fill="#4b5d78" text-anchor="start">financeiro · aprova · classifica na DRE</text><circle cx="654" cy="196" r="10" fill="#5b3cc4"/><text x="674" y="192" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="800" fill="#5b3cc4" text-anchor="start">Flávio (Diretor)</text><text x="674" y="214" font-family="Arial,Helvetica,sans-serif" font-size="18" font-weight="500" fill="#4b5d78" text-anchor="start">aprova despesas, repasses e comissões</text><circle cx="1226" cy="196" r="10" fill="#ef233c"/><text x="1246" y="192" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="800" fill="#ef233c" text-anchor="start">Socorro (Tesouraria)</text><text x="1246" y="214" font-family="Arial,Helvetica,sans-serif" font-size="18" font-weight="500" fill="#4b5d78" text-anchor="start">paga, arquiva, comprovantes e confirma créditos</text><circle cx="1798" cy="196" r="10" fill="#0b8fd3"/><text x="1818" y="192" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="800" fill="#0b8fd3" text-anchor="start">Reinaldo (Jurídico)</text><text x="1818" y="214" font-family="Arial,Helvetica,sans-serif" font-size="18" font-weight="500" fill="#4b5d78" text-anchor="start">receitas, repasse de alvarás e comissões</text><rect x="40" y="245" width="1145" height="1400" rx="22" fill="#ffffff" stroke="#ffd5da" stroke-width="2"/><rect x="40" y="245" width="1145" height="110" rx="22" fill="#ef233c" stroke="none" stroke-width="2"/><circle cx="100" cy="300" r="40" fill="#fff"/><text x="100" y="313" font-family="Arial,Helvetica,sans-serif" font-size="38" font-weight="800" fill="#ef233c" text-anchor="middle">$</text><text x="160" y="293" font-family="Arial,Helvetica,sans-serif" font-size="34" font-weight="800" fill="#fff" text-anchor="start">Fluxo de Despesas</text><text x="160" y="329" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="500" fill="#ffffff" text-anchor="start">Da solicitação à DRE</text><rect x="885" y="267" width="270" height="66" rx="12" fill="#c8102e" stroke="none" stroke-width="2"/><text x="1020" y="295" font-family="Arial,Helvetica,sans-serif" font-size="19" font-weight="700" fill="#fff" text-anchor="middle">Controle de despesas</text><text x="1020" y="321" font-family="Arial,Helvetica,sans-serif" font-size="19" font-weight="700" fill="#fff" text-anchor="middle">com rastreabilidade</text><rect x="70" y="380" width="1085" height="78" rx="14" fill="#fff1f3" stroke="#e9a0aa" stroke-width="2"/><circle cx="106" cy="419.0" r="22" fill="#ef233c"/><text x="106" y="427.0" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="800" fill="#fff" text-anchor="middle">1</text><text x="144" y="413.0" font-family="Arial,Helvetica,sans-serif" font-size="25" font-weight="700" fill="#10233f" text-anchor="start">Menu Despesas → Nova Despesa</text><text x="144" y="443.0" font-family="Arial,Helvetica,sans-serif" font-size="20" font-weight="500" fill="#4b5d78" text-anchor="start">Lança: Tesouraria / Operador</text><path d="M612,458 L612,480" stroke="#ef233c" stroke-width="4" fill="none" marker-end="url(#arrow)"/><rect x="70" y="482" width="1085" height="78" rx="14" fill="#fff1f3" stroke="#e9a0aa" stroke-width="2"/><circle cx="106" cy="521.0" r="22" fill="#ef233c"/><text x="106" y="529.0" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="800" fill="#fff" text-anchor="middle">2</text><text x="144" y="515.0" font-family="Arial,Helvetica,sans-serif" font-size="25" font-weight="700" fill="#10233f" text-anchor="start">Preencher o demonstrativo</text><text x="144" y="545.0" font-family="Arial,Helvetica,sans-serif" font-size="20" font-weight="500" fill="#4b5d78" text-anchor="start">Fornecedor, competência, unidade, conta e valores</text><path d="M612,560 L612,582" stroke="#ef233c" stroke-width="4" fill="none" marker-end="url(#arrow)"/><rect x="70" y="584" width="1085" height="78" rx="14" fill="#fff1f3" stroke="#e9a0aa" stroke-width="2"/><circle cx="106" cy="623.0" r="22" fill="#ef233c"/><text x="106" y="631.0" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="800" fill="#fff" text-anchor="middle">3</text><text x="144" y="617.0" font-family="Arial,Helvetica,sans-serif" font-size="25" font-weight="700" fill="#10233f" text-anchor="start">Informar a movimentação financeira prevista</text><text x="144" y="647.0" font-family="Arial,Helvetica,sans-serif" font-size="20" font-weight="500" fill="#4b5d78" text-anchor="start">Data prevista e conta bancária de pagamento</text><path d="M612,662 L612,684" stroke="#ef233c" stroke-width="4" fill="none" marker-end="url(#arrow)"/><rect x="70" y="686" width="1085" height="78" rx="14" fill="#fff1f3" stroke="#e9a0aa" stroke-width="2"/><circle cx="106" cy="725.0" r="22" fill="#ef233c"/><text x="106" y="733.0" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="800" fill="#fff" text-anchor="middle">4</text><text x="144" y="719.0" font-family="Arial,Helvetica,sans-serif" font-size="25" font-weight="700" fill="#10233f" text-anchor="start">Anexar a documentação comprobatória</text><text x="144" y="749.0" font-family="Arial,Helvetica,sans-serif" font-size="20" font-weight="500" fill="#4b5d78" text-anchor="start">Nota, boleto ou recibo — antes de enviar</text><path d="M612,764 L612,786" stroke="#ef233c" stroke-width="4" fill="none" marker-end="url(#arrow)"/><rect x="70" y="788" width="1085" height="78" rx="14" fill="#fff1f3" stroke="#e9a0aa" stroke-width="2"/><circle cx="106" cy="827.0" r="22" fill="#ef233c"/><text x="106" y="835.0" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="800" fill="#fff" text-anchor="middle">5</text><text x="144" y="836.0" font-family="Arial,Helvetica,sans-serif" font-size="25" font-weight="700" fill="#10233f" text-anchor="start">Salvar rascunho ou Enviar para Aprovação</text><polygon points="612,890.0 847.0,960 612,1030.0 377.0,960" fill="#fff2bf" stroke="#e0a106" stroke-width="3"/><text x="612" y="954" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="700" fill="#3a2a00" text-anchor="middle">Fernando (Master) ou</text><text x="612" y="984" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="700" fill="#3a2a00" text-anchor="middle">Flávio (Diretor) aprova?</text><text x="290" y="908" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="800" fill="#d90429" text-anchor="middle">NÃO</text><text x="940" y="908" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="800" fill="#07913d" text-anchor="middle">SIM</text><path d="M377,960 L220,960 L220,1055" stroke="#d90429" stroke-width="5" fill="none" marker-end="url(#arrow)"/><path d="M847,960 L900,960 L900,1055" stroke="#07913d" stroke-width="5" fill="none" marker-end="url(#arrow)"/><rect x="70" y="1065" width="450" height="84" rx="14" fill="#fff1f3" stroke="#e9a0aa" stroke-width="2"/><text x="92" y="1101.0" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="700" fill="#10233f" text-anchor="start">Devolvido (com justificativa)</text><text x="92" y="1131.0" font-family="Arial,Helvetica,sans-serif" font-size="20" font-weight="500" fill="#c8102e" text-anchor="start">Editar → corrige e reenvia</text><rect x="70" y="1169" width="450" height="84" rx="14" fill="#fff1f3" stroke="#e9a0aa" stroke-width="2"/><text x="92" y="1205.0" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="700" fill="#10233f" text-anchor="start">Rejeitado (com justificativa)</text><text x="92" y="1235.0" font-family="Arial,Helvetica,sans-serif" font-size="20" font-weight="500" fill="#c8102e" text-anchor="start">Fim do fluxo — sem reenvio</text><rect x="600" y="1065" width="555" height="84" rx="14" fill="#effbf3" stroke="#7fc99a" stroke-width="2"/><text x="622" y="1101.0" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="700" fill="#10233f" text-anchor="start">Aprovado</text><text x="622" y="1131.0" font-family="Arial,Helvetica,sans-serif" font-size="20" font-weight="500" fill="#4b5d78" text-anchor="start">Sai da fila de Aprovações</text><path d="M877.5,1149 L877.5,1167" stroke="#07913d" stroke-width="4" fill="none" marker-end="url(#arrow)"/><rect x="600" y="1169" width="555" height="84" rx="14" fill="#effbf3" stroke="#7fc99a" stroke-width="2"/><text x="622" y="1205.0" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="700" fill="#10233f" text-anchor="start">Socorro marca como Pago</text><text x="622" y="1235.0" font-family="Arial,Helvetica,sans-serif" font-size="20" font-weight="500" fill="#4b5d78" text-anchor="start">Baixa Financeira — informa a data</text><path d="M877.5,1253 L877.5,1271" stroke="#07913d" stroke-width="4" fill="none" marker-end="url(#arrow)"/><rect x="600" y="1273" width="555" height="84" rx="14" fill="#eef5ff" stroke="#8bb4ea" stroke-width="2"/><text x="622" y="1309.0" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="700" fill="#10233f" text-anchor="start">Socorro arquiva</text><text x="622" y="1339.0" font-family="Arial,Helvetica,sans-serif" font-size="20" font-weight="500" fill="#4b5d78" text-anchor="start">Despesa preservada nos relatórios</text><path d="M877.5,1357 L877.5,1375" stroke="#07913d" stroke-width="4" fill="none" marker-end="url(#arrow)"/><rect x="600" y="1377" width="555" height="84" rx="14" fill="#f4efff" stroke="#b19ce8" stroke-width="2"/><text x="622" y="1413.0" font-family="Arial,Helvetica,sans-serif" font-size="24" font-weight="700" fill="#10233f" text-anchor="start">Fernando classifica na DRE</text><text x="622" y="1443.0" font-family="Arial,Helvetica,sans-serif" font-size="20" font-weight="500" fill="#4b5d78" text-anchor="start">DRE Gerencial → Classificação</text><rect x="70" y="1560" width="1085" height="60" rx="12" fill="#fff1f3" stroke="none" stroke-width="2"/><text x="95" y="1598" font-family="Arial,Helvetica,sans-serif" font-size="20" font-weight="700" fill="#c8102e" text-anchor="start">Reflexos: Auditoria, Fluxo de Caixa, Calendário, Conciliação Bancária, Contabilidade e DRE Gerencial</text><rect x="1215" y="245" width="1145" height="1400" rx="22" fill="#ffffff" stroke="#c8e9fb" stroke-width="2"/><rect x="1215" y="245" width="1145" height="110" rx="22" fill="#0b8fd3" stroke="none" stroke-width="2"/><circle cx="1275" cy="300" r="40" fill="#fff"/><text x="1275" y="313" font-family="Arial,Helvetica,sans-serif" font-size="38" font-weight="800" fill="#0b8fd3" text-anchor="middle">R</text><text x="1335" y="293" font-family="Arial,Helvetica,sans-serif" font-size="34" font-weight="800" fill="#fff" text-anchor="start">Fluxo de Receitas</text><text x="1335" y="329" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="500" fill="#ffffff" text-anchor="start">Do registro ao encerramento</text><rect x="2060" y="267" width="270" height="66" rx="12" fill="#0a6fa6" stroke="none" stroke-width="2"/><text x="2195" y="295" font-family="Arial,Helvetica,sans-serif" font-size="19" font-weight="700" fill="#fff" text-anchor="middle">Controle de receitas</text><text x="2195" y="321" font-family="Arial,Helvetica,sans-serif" font-size="19" font-weight="700" fill="#fff" text-anchor="middle">com segurança</text><rect x="1245" y="380" width="1085" height="72" rx="14" fill="#eef8fe" stroke="#8fcdee" stroke-width="2"/><circle cx="1281" cy="416.0" r="22" fill="#0b8fd3"/><text x="1281" y="424.0" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="800" fill="#fff" text-anchor="middle">1</text><text x="1319" y="410.0" font-family="Arial,Helvetica,sans-serif" font-size="25" font-weight="700" fill="#10233f" text-anchor="start">Menu Receitas → Nova Receita</text><text x="1319" y="440.0" font-family="Arial,Helvetica,sans-serif" font-size="20" font-weight="500" fill="#4b5d78" text-anchor="start">Lança: Reinaldo (Jurídico)</text><path d="M1787,452 L1787,468" stroke="#0b8fd3" stroke-width="4" fill="none" marker-end="url(#arrow)"/><rect x="1245" y="470" width="1085" height="72" rx="14" fill="#eef8fe" stroke="#8fcdee" stroke-width="2"/><circle cx="1281" cy="506.0" r="22" fill="#0b8fd3"/><text x="1281" y="514.0" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="800" fill="#fff" text-anchor="middle">2</text><text x="1319" y="500.0" font-family="Arial,Helvetica,sans-serif" font-size="25" font-weight="700" fill="#10233f" text-anchor="start">Escolher o tipo</text><text x="1319" y="530.0" font-family="Arial,Helvetica,sans-serif" font-size="20" font-weight="500" fill="#4b5d78" text-anchor="start">Alvará · Acordo Trabalhista · Outras Receitas</text><path d="M1787,542 L1787,558" stroke="#0b8fd3" stroke-width="4" fill="none" marker-end="url(#arrow)"/><rect x="1245" y="560" width="1085" height="72" rx="14" fill="#eef8fe" stroke="#8fcdee" stroke-width="2"/><circle cx="1281" cy="596.0" r="22" fill="#0b8fd3"/><text x="1281" y="604.0" font-family="Arial,Helvetica,sans-serif" font-size="22" font-weight="800" fill="#fff" text-anchor="middle">3</text><text x="1319" y="590.0" font-family="Arial,Helvetica,sans-serif" font-size="25" font-weight="700" fill="#10233f" text-anchor="start">Preencher o processo e o recebimento</text><text x="1319" y="620.0" font-family="Arial,Helvetica,sans-serif" font-size="20" font-weight="500" fill="#4b5d78" text-anchor="start">Composição do valor, honorários e participações</text><path d="M1787,632 L1787,648" stroke="#0b8fd3" stroke-width="4" fill="none" marker-end="url(#arrow)"/>