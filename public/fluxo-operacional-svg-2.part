line x1="1200.0" y1="1713" x2="1200.0" y2="1758" stroke="#d90429" stroke-width="4" marker-end="url(#arrow)"/><rect x="990.0" y="1725" width="420" height="78" rx="14" fill="#fff1f3" stroke="#ff6b7c" stroke-width="2"/><text x="1030.0" y="1773" font-family="Arial,Helvetica,sans-serif" font-size="19" font-weight="800" fill="#d90429" text-anchor="start">3   Rejeitado — ajusta e reenvia</text><rect x="40" y="1975" width="2320" height="55" rx="12" fill="#eef3f8" stroke="none" stroke-width="2"/><text x="1200.0" y="2010" font-family="Arial,Helvetica,sans-serif" font-size="18" font-weight="600" fill="#233b5d" text-anchor="middle">Os documentos devem permanecer anexados no sistema, evitando o envio e a circulação de documentos em papel.</text></svg>