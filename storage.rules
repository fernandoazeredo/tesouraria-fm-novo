rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    function isPrimaryAdminEmail() {
      return authEmail() == 'fernandoazeredo64@gmail.com';
    }

    function isDirectorEmail() {
      return authEmail() == 'flavio.marques@marquesemuller.adv.br';
    }

    function isManagerEmail() {
      return authEmail() == 'reinaldo@marquesemuller.adv.br';
    }

    function isTreasuryEmail() {
      return authEmail() == 'socorro@marquesemuller.adv.br';
    }

    function financialReader() {
      return isPrimaryAdminEmail() || isDirectorEmail() || isManagerEmail() || isTreasuryEmail();
    }

    function financialWriter() {
      return isPrimaryAdminEmail() || isManagerEmail() || isTreasuryEmail();
    }

    function validAttachmentSize() {
      return request.resource == null || request.resource.size <= 20 * 1024 * 1024;
    }

    function validBankStatementSize() {
      return request.resource == null || request.resource.size <= 30 * 1024 * 1024;
    }

    match /despesas/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (request.auth.uid == userId || isPrimaryAdminEmail())
        && validAttachmentSize();
      allow delete: if signedIn()
        && (request.auth.uid == userId || isPrimaryAdminEmail());
    }

    match /recebimentos/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (request.auth.uid == userId || isPrimaryAdminEmail())
        && validAttachmentSize();
      allow delete: if signedIn()
        && (request.auth.uid == userId || isPrimaryAdminEmail());
    }

    match /demonstrativos/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validAttachmentSize();
      allow delete: if isPrimaryAdminEmail();
    }

    // Extrato consolidado mensal usado no ZIP da Contabilidade.
    // Usa e-mails oficiais do Firebase Auth para evitar dependencia de consulta
    // cruzada ao Firestore durante upload/download.
    match /extratos-bancarios/{allPaths=**} {
      allow read: if financialReader();
      allow create, update: if financialWriter() && validBankStatementSize();
      allow delete: if financialWriter();
    }

    // Pacotes preparados para envio à Contabilidade por link.
    // O link de download usa token do Firebase Storage; não há exclusão automática.
    match /envios-contabilidade/{allPaths=**} {
      allow read: if financialReader();
      allow create, update: if financialWriter()
        && request.resource.size <= 250 * 1024 * 1024;
      allow delete: if isPrimaryAdminEmail();
    }

    // Estrutura antiga mantida somente para leitura/limpeza de pacotes já existentes.
    match /pacotes-contabeis/{allPaths=**} {
      allow read: if financialReader();
      allow write: if isPrimaryAdminEmail();
    }
  }
}
