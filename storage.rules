rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Somente e-mails verificados pelo Firebase Auth concedem papel por e-mail.
    // Impede que uma conta e-mail/senha não verificada assuma o e-mail de um sócio.
    function authEmail() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email_verified == true
        ? request.auth.token.email.lower()
        : '';
    }

    function rawEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isPrimaryAdminEmail() {
      return authEmail() == 'fernandoazeredo64@gmail.com';
    }

    function isDirectorEmail() {
      return authEmail() == 'flavio.marques@marquesemuller.adv.br';
    }

    function isManagerEmail() {
      return authEmail() == 'reinaldo@marquesemuller.adv.br';
    }

    function isTreasuryEmail() {
      return authEmail() == 'socorro@marquesemuller.adv.br';
    }

    function officialReaderEmail(email) {
      return email in [
        'fernandoazeredo64@gmail.com',
        'flavio.marques@marquesemuller.adv.br',
        'reinaldo@marquesemuller.adv.br',
        'socorro@marquesemuller.adv.br'
      ];
    }

    function officialWriterEmail(email) {
      return email in [
        'fernandoazeredo64@gmail.com',
        'reinaldo@marquesemuller.adv.br',
        'socorro@marquesemuller.adv.br'
      ];
    }

    // E-mail oficial verificado, ou e-mail oficial com cadastro ativo
    // (cadastro ativo só existe após liberação manual do Master).
    function financialReader() {
      return officialReaderEmail(authEmail())
        || (officialReaderEmail(rawEmail()) && activeUser());
    }

    function financialWriter() {
      return officialWriterEmail(authEmail())
        || (officialWriterEmail(rawEmail()) && activeUser());
    }

    function activeUser() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // A consulta cruzada ao Firestore depende das permissões de um service agent
    // distinto da conta do GitHub Actions. As contas financeiras oficiais já
    // identificadas no Firebase Auth têm uma rota explícita e restrita de acesso.
    // Mantemos a autorização anterior para usuários ativos.
    function demonstrativeAuthorizedUser() {
      return signedIn() && (financialReader() || activeUser());
    }

    // Exclusão de PDFs somente na janela de limpeza solicitada pelo Master.
    // Sem a janela temporária no Firestore, os PDFs permanecem imutáveis.
    function masterWipeMode() {
      return signedIn()
        && isPrimaryAdminEmail()
        && firestore.exists(/databases/(default)/documents/systemControl/wipe)
        && firestore.get(/databases/(default)/documents/systemControl/wipe).data.uid == request.auth.uid
        && firestore.get(/databases/(default)/documents/systemControl/wipe).data.expiresAt > request.time;
    }

    function validAttachmentSize() {
      return request.resource == null || request.resource.size <= 20 * 1024 * 1024;
    }

    function validBankStatementSize() {
      return request.resource == null || request.resource.size <= 30 * 1024 * 1024;
    }

    // Comprovantes: somente usuários com cadastro ativo (ou contas financeiras
    // oficiais). Antes bastava estar logado, o que incluía qualquer conta Google.
    match /despesas/{userId}/{allPaths=**} {
      allow read: if demonstrativeAuthorizedUser();
      allow create, update: if signedIn()
        && ((request.auth.uid == userId && activeUser()) || isPrimaryAdminEmail())
        && validAttachmentSize();
      allow delete: if signedIn()
        && ((request.auth.uid == userId && activeUser()) || isPrimaryAdminEmail());
    }

    match /recebimentos/{userId}/{allPaths=**} {
      allow read: if demonstrativeAuthorizedUser();
      allow create, update: if signedIn()
        && ((request.auth.uid == userId && activeUser()) || isPrimaryAdminEmail())
        && validAttachmentSize();
      allow delete: if signedIn()
        && ((request.auth.uid == userId && activeUser()) || isPrimaryAdminEmail());
    }

    match /demonstrativos/{allPaths=**} {
      allow read: if demonstrativeAuthorizedUser();
      allow create: if demonstrativeAuthorizedUser()
        && validAttachmentSize()
        && request.resource.contentType == 'application/pdf';
      allow update: if false;
      allow delete: if masterWipeMode();
    }

    // Extrato consolidado mensal usado no ZIP da Contabilidade.
    // Usa e-mails oficiais do Firebase Auth para evitar dependencia de consulta
    // cruzada ao Firestore durante upload/download.
    match /extratos-bancarios/{allPaths=**} {
      allow read: if financialReader();
      allow create, update: if financialWriter() && validBankStatementSize();
      allow delete: if financialWriter();
    }

    // ZIPs mensais enviados à Contabilidade (removidos junto com o extrato).
    match /envios-contabilidade/{allPaths=**} {
      allow read: if financialReader();
      allow create, update: if financialWriter() && validBankStatementSize();
      allow delete: if financialWriter();
    }

    // Estrutura antiga mantida somente para leitura/limpeza de pacotes já existentes.
    match /pacotes-contabeis/{allPaths=**} {
      allow read: if financialReader();
      allow write: if isPrimaryAdminEmail();
    }
  }
}
