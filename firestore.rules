rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : '';
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    // O Master principal só é reconhecido com e-mail verificado (login Google).
    function isPrimaryAdminEmail() {
      return emailVerified() && authEmail() == 'fernandoazeredo64@gmail.com';
    }

    // Campos que não podem mudar fora do rascunho/devolução.
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function sameInstallmentCount() {
      return !('installments' in resource.data)
        || (request.resource.data.installments is list
          && request.resource.data.installments.size() == resource.data.installments.size());
    }

    function expenseValuesLocked() {
      return unchanged(['valorTotal', 'items', 'fornecedor', 'documento', 'nome', 'unidade',
        'competencia', 'createdBy', 'createdAt']);
    }

    function receivableValuesLocked() {
      return unchanged(['valorAlvara', 'baseCalculo', 'valorLiquidoCliente', 'totalDeducoes',
        'components', 'agentCommissionValue', 'invoiceValue', 'createdBy', 'createdAt']);
    }

    // Valor de cada parcela (até 60, limite da tela) não muda após o envio para aprovação.
    // As regras não têm laço, por isso cada posição é verificada explicitamente.
    function installmentValueSame(i) {
      return request.resource.data.installments[i].value == resource.data.installments[i].value;
    }

    function installmentValuesLocked() {
      return !('installments' in resource.data) || (
        resource.data.installments.size() <= 60
        && (resource.data.installments.size() <= 0 || installmentValueSame(0))
        && (resource.data.installments.size() <= 1 || installmentValueSame(1))
        && (resource.data.installments.size() <= 2 || installmentValueSame(2))
        && (resource.data.installments.size() <= 3 || installmentValueSame(3))
        && (resource.data.installments.size() <= 4 || installmentValueSame(4))
        && (resource.data.installments.size() <= 5 || installmentValueSame(5))
        && (resource.data.installments.size() <= 6 || installmentValueSame(6))
        && (resource.data.installments.size() <= 7 || installmentValueSame(7))
        && (resource.data.installments.size() <= 8 || installmentValueSame(8))
        && (resource.data.installments.size() <= 9 || installmentValueSame(9))
        && (resource.data.installments.size() <= 10 || installmentValueSame(10))
        && (resource.data.installments.size() <= 11 || installmentValueSame(11))
        && (resource.data.installments.size() <= 12 || installmentValueSame(12))
        && (resource.data.installments.size() <= 13 || installmentValueSame(13))
        && (resource.data.installments.size() <= 14 || installmentValueSame(14))
        && (resource.data.installments.size() <= 15 || installmentValueSame(15))
        && (resource.data.installments.size() <= 16 || installmentValueSame(16))
        && (resource.data.installments.size() <= 17 || installmentValueSame(17))
        && (resource.data.installments.size() <= 18 || installmentValueSame(18))
        && (resource.data.installments.size() <= 19 || installmentValueSame(19))
        && (resource.data.installments.size() <= 20 || installmentValueSame(20))
        && (resource.data.installments.size() <= 21 || installmentValueSame(21))
        && (resource.data.installments.size() <= 22 || installmentValueSame(22))
        && (resource.data.installments.size() <= 23 || installmentValueSame(23))
        && (resource.data.installments.size() <= 24 || installmentValueSame(24))
        && (resource.data.installments.size() <= 25 || installmentValueSame(25))
        && (resource.data.installments.size() <= 26 || installmentValueSame(26))
        && (resource.data.installments.size() <= 27 || installmentValueSame(27))
        && (resource.data.installments.size() <= 28 || installmentValueSame(28))
        && (resource.data.installments.size() <= 29 || installmentValueSame(29))
        && (resource.data.installments.size() <= 30 || installmentValueSame(30))
        && (resource.data.installments.size() <= 31 || installmentValueSame(31))
        && (resource.data.installments.size() <= 32 || installmentValueSame(32))
        && (resource.data.installments.size() <= 33 || installmentValueSame(33))
        && (resource.data.installments.size() <= 34 || installmentValueSame(34))
        && (resource.data.installments.size() <= 35 || installmentValueSame(35))
        && (resource.data.installments.size() <= 36 || installmentValueSame(36))
        && (resource.data.installments.size() <= 37 || installmentValueSame(37))
        && (resource.data.installments.size() <= 38 || installmentValueSame(38))
        && (resource.data.installments.size() <= 39 || installmentValueSame(39))
        && (resource.data.installments.size() <= 40 || installmentValueSame(40))
        && (resource.data.installments.size() <= 41 || installmentValueSame(41))
        && (resource.data.installments.size() <= 42 || installmentValueSame(42))
        && (resource.data.installments.size() <= 43 || installmentValueSame(43))
        && (resource.data.installments.size() <= 44 || installmentValueSame(44))
        && (resource.data.installments.size() <= 45 || installmentValueSame(45))
        && (resource.data.installments.size() <= 46 || installmentValueSame(46))
        && (resource.data.installments.size() <= 47 || installmentValueSame(47))
        && (resource.data.installments.size() <= 48 || installmentValueSame(48))
        && (resource.data.installments.size() <= 49 || installmentValueSame(49))
        && (resource.data.installments.size() <= 50 || installmentValueSame(50))
        && (resource.data.installments.size() <= 51 || installmentValueSame(51))
        && (resource.data.installments.size() <= 52 || installmentValueSame(52))
        && (resource.data.installments.size() <= 53 || installmentValueSame(53))
        && (resource.data.installments.size() <= 54 || installmentValueSame(54))
        && (resource.data.installments.size() <= 55 || installmentValueSame(55))
        && (resource.data.installments.size() <= 56 || installmentValueSame(56))
        && (resource.data.installments.size() <= 57 || installmentValueSame(57))
        && (resource.data.installments.size() <= 58 || installmentValueSame(58))
        && (resource.data.installments.size() <= 59 || installmentValueSame(59))
      );
    }

    function paymentControlValuesLocked() {
      return unchanged(['amountDue', 'amountReceived', 'grossAmount', 'deductions', 'deductionTotal',
          'netAmountDue', 'sourceReceivableId', 'beneficiary', 'installmentCount', 'createdBy', 'createdAt'])
        && sameInstallmentCount()
        && installmentValuesLocked();
    }

    function isDirectorEmail() {
      return authEmail() == 'flavio.marques@marquesemuller.adv.br';
    }

    function isManagerEmail() {
      return authEmail() == 'reinaldo@marquesemuller.adv.br';
    }

    function isTreasuryEmail() {
      return authEmail() == 'socorro@marquesemuller.adv.br';
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && currentUser().data.status == 'active';
    }

    function hasRole(roles) {
      return activeUser() && currentUser().data.role in roles;
    }

    function masterWipeMode() {
      return isPrimaryAdminEmail()
        && hasRole(['master'])
        && exists(/databases/$(database)/documents/systemControl/wipe)
        && get(/databases/$(database)/documents/systemControl/wipe).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/systemControl/wipe).data.expiresAt > request.time;
    }

    function masterRestoreMode() {
      return isPrimaryAdminEmail()
        && exists(/databases/$(database)/documents/systemControl/restore)
        && get(/databases/$(database)/documents/systemControl/restore).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/systemControl/restore).data.expiresAt > request.time;
    }

    function validSelfRegistration(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (
          (isPrimaryAdminEmail()
            && request.resource.data.role == 'master'
            && request.resource.data.status == 'active')
          ||
          (isDirectorEmail() && emailVerified()
            && request.resource.data.role == 'diretor'
            && request.resource.data.status == 'pending')
          ||
          (isManagerEmail() && emailVerified()
            && request.resource.data.role == 'gerente'
            && request.resource.data.status == 'pending')
          ||
          (isTreasuryEmail() && emailVerified()
            && request.resource.data.role == 'tesouraria'
            && request.resource.data.status == 'pending')
          ||
          (!isPrimaryAdminEmail()
            && !isDirectorEmail()
            && !isManagerEmail()
            && !isTreasuryEmail()
            && request.resource.data.role == 'operador'
            && request.resource.data.status == 'pending')
        );
    }

    function safeSelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'photoURL', 'lastLoginAt']);
    }

    function directorExpenseDecision() {
      return (
          (isDirectorEmail() && hasRole(['diretor']))
          || (isPrimaryAdminEmail() && hasRole(['master']))
        )
        && resource.data.status in ['enviado_aprovacao', 'em_analise']
        && request.resource.data.status in ['aprovado', 'devolvido', 'rejeitado']
        && expenseValuesLocked();
    }

    function operationalExpenseUpdate() {
      return hasRole(['master', 'gerente', 'tesouraria', 'operador'])
        && (hasRole(['master']) || resource.data.createdBy == request.auth.uid)
        && unchanged(['createdBy', 'createdAt'])
        && (
          (resource.data.status == 'rascunho'
            && request.resource.data.status in ['rascunho', 'enviado_aprovacao'])
          ||
          (resource.data.status == 'devolvido'
            && request.resource.data.status in ['devolvido', 'enviado_aprovacao'])
        );
    }

    function treasuryExpenseClose() {
      return hasRole(['master', 'tesouraria'])
        && (
          (resource.data.status == 'aprovado'
            && request.resource.data.status in ['aprovado', 'pago'])
          ||
          (resource.data.status == 'pago'
            && request.resource.data.status in ['pago', 'arquivado'])
        )
        && expenseValuesLocked();
    }

    // Operador só altera a própria receita; Master e Gerente revisam qualquer uma.
    function originReceivableUpdate() {
      return hasRole(['master', 'gerente', 'operador'])
        && (hasRole(['master', 'gerente']) || resource.data.createdBy == request.auth.uid)
        && unchanged(['createdBy', 'createdAt'])
        && (
          (resource.data.status == 'rascunho'
            && request.resource.data.status in ['rascunho', 'enviado_tesouraria'])
          ||
          (resource.data.status == 'devolvido'
            && request.resource.data.status in ['devolvido', 'enviado_tesouraria'])
        );
    }

    function treasuryReceivableUpdate() {
      return hasRole(['master', 'tesouraria'])
        && (
          (resource.data.status == 'enviado_tesouraria'
            && request.resource.data.status in ['enviado_tesouraria', 'recebido_tesouraria', 'devolvido'])
          ||
          (resource.data.status == 'recebido_tesouraria'
            && request.resource.data.status in ['recebido_tesouraria', 'encerrado'])
        )
        && receivableValuesLocked();
    }

    function paymentControlDecision() {
      return (
          (isDirectorEmail() && hasRole(['diretor']))
          || (isPrimaryAdminEmail() && hasRole(['master']))
        )
        && resource.data.status == 'aguardando_aprovacao'
        && request.resource.data.status in ['aprovado', 'devolvido', 'rejeitado']
        && paymentControlValuesLocked();
    }

    function paymentControlOperationalUpdate() {
      return hasRole(['master', 'tesouraria'])
        && (
          (resource.data.status in ['devolvido', 'rejeitado']
            && request.resource.data.status == 'aguardando_aprovacao')
          ||
          (resource.data.status == 'aprovado'
            && request.resource.data.status in ['aprovado', 'parcialmente_pago', 'pago']
            && paymentControlValuesLocked())
          ||
          (resource.data.status == 'parcialmente_pago'
            && request.resource.data.status in ['parcialmente_pago', 'pago']
            && paymentControlValuesLocked())
        );
    }

    function societaryDecisionUser() {
      return (isPrimaryAdminEmail() && hasRole(['master']))
        || (isDirectorEmail() && hasRole(['diretor']));
    }

    function societaryCreate(documentId) {
      return hasRole(['master', 'diretor', 'tesouraria'])
        && request.resource.data.sourceReceivableId == documentId
        && request.resource.data.status == 'apurado';
    }

    function societaryDirectorUpdate() {
      return societaryDecisionUser()
        && (
          (resource.data.status == 'apurado'
            && request.resource.data.status in ['apurado', 'aguardando_aprovacao', 'cancelado'])
          ||
          (resource.data.status == 'aguardando_aprovacao'
            && request.resource.data.status in ['aprovado', 'devolvido', 'rejeitado', 'cancelado'])
          ||
          (resource.data.status in ['devolvido', 'rejeitado']
            && request.resource.data.status in ['apurado', 'aguardando_aprovacao', 'cancelado'])
          ||
          (resource.data.status == 'aprovado'
            && request.resource.data.status in ['enviado_tesouraria', 'apurado', 'cancelado'])
          ||
          (resource.data.status == 'enviado_tesouraria'
            && request.resource.data.status in ['apurado', 'cancelado'])
        );
    }

    function societaryTreasuryUpdate() {
      return hasRole(['master', 'tesouraria'])
        && resource.data.status == 'enviado_tesouraria'
        && request.resource.data.status in ['pago', 'rejeitado']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'paidValue', 'paymentDate', 'paymentGroupId', 'paymentReference',
          'paidBy', 'paidByName', 'paidAt', 'updatedAt', 'rejectionReason',
          'returnedByTreasury', 'returnedByTreasuryName', 'returnedAt'])
        && (request.resource.data.status != 'pago'
          || request.resource.data.paidValue == resource.data.transferValue);
    }

    function bankPeriodOpen(periodId) {
      return periodId != null
        && (
          !exists(/databases/$(database)/documents/bankReconciliationPeriods/$(periodId))
          || get(/databases/$(database)/documents/bankReconciliationPeriods/$(periodId)).data.status != 'fechada'
        );
    }

    function canCloseBankPeriod() {
      return hasRole(['master', 'gerente', 'tesouraria'])
        && resource.data.status == 'aberta'
        && request.resource.data.status == 'fechada';
    }

    function canReopenBankPeriod() {
      return isPrimaryAdminEmail()
        && hasRole(['master'])
        && resource.data.status == 'fechada'
        && request.resource.data.status == 'aberta';
    }

    match /systemControl/{document=**} {
      allow read, create, update, delete: if isPrimaryAdminEmail();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || hasRole(['master']));
      allow create: if validSelfRegistration(userId) || masterRestoreMode();
      allow update: if signedIn() && (
        (request.auth.uid == userId && safeSelfUpdate())
        || hasRole(['master'])
        || masterRestoreMode()
      );
      allow delete: if (hasRole(['master']) && request.auth.uid != userId) || masterRestoreMode();
    }

    match /userPermissions/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId
        || (request.auth.token.email != null && userId == 'email:' + request.auth.token.email.lower())
        || (isPrimaryAdminEmail() && hasRole(['master'])));
      allow create, update: if masterRestoreMode() ||
        (isPrimaryAdminEmail() && hasRole(['master'])
          && request.resource.data.keys().hasOnly(['schemaVersion', 'modules', 'updatedBy', 'updatedAt'])
          && request.resource.data.updatedBy == request.auth.uid);
      allow delete: if isPrimaryAdminEmail() && hasRole(['master']);
    }

    match /userInvites/{document=**} {
      allow read, write: if false;
    }

    match /expenses/{document=**} {
      allow read: if activeUser();
      allow create: if masterRestoreMode() || (
        hasRole(['master', 'gerente', 'tesouraria', 'operador'])
        && request.resource.data.status in ['rascunho', 'enviado_aprovacao']
        && request.resource.data.createdBy == request.auth.uid
      );
      allow update: if masterRestoreMode()
        || directorExpenseDecision()
        || operationalExpenseUpdate()
        || treasuryExpenseClose();
      allow delete: if masterRestoreMode()
        || hasRole(['master'])
        || (hasRole(['gerente', 'tesouraria', 'operador'])
          && resource.data.status == 'rascunho'
          && resource.data.createdBy == request.auth.uid);
    }

    match /receivables/{document=**} {
      allow read: if activeUser();
      allow create: if masterRestoreMode() || (
        hasRole(['master', 'gerente', 'operador'])
        && request.resource.data.status in ['rascunho', 'enviado_tesouraria']
        && request.resource.data.createdBy == request.auth.uid
      );
      allow update: if masterRestoreMode() || originReceivableUpdate() || treasuryReceivableUpdate();
      allow delete: if masterRestoreMode() || hasRole(['master']);
    }

    match /alvaraTransfers/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow create: if masterRestoreMode() || (
        hasRole(['master', 'tesouraria'])
        && request.resource.data.status == 'aguardando_aprovacao'
      );
      allow update: if masterRestoreMode()
        || paymentControlDecision()
        || paymentControlOperationalUpdate();
      allow delete: if masterRestoreMode() || hasRole(['master']);
    }

    match /agentCommissions/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow create: if masterRestoreMode() || (
        hasRole(['master', 'tesouraria'])
        && request.resource.data.status == 'aguardando_aprovacao'
      );
      allow update: if masterRestoreMode()
        || paymentControlDecision()
        || paymentControlOperationalUpdate();
      allow delete: if masterRestoreMode() || hasRole(['master']);
    }

    match /societaryTransfers/{documentId} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow create: if masterRestoreMode() || societaryCreate(documentId);
      allow update: if masterRestoreMode()
        || societaryDirectorUpdate()
        || societaryTreasuryUpdate();
      allow delete: if masterWipeMode();
    }

    match /fiscalNotes/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow create, update: if masterRestoreMode() || hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow delete: if masterRestoreMode() || hasRole(['master']);
    }

    match /approvals/{document=**} {
      allow read: if activeUser();
      allow create, update: if (isDirectorEmail() && hasRole(['diretor']))
        || (isPrimaryAdminEmail() && hasRole(['master']));
      allow delete: if hasRole(['master']);
    }

    match /chartOfAccounts/{document=**} {
      allow read: if activeUser();
      allow write: if masterRestoreMode() || (isPrimaryAdminEmail() && hasRole(['master']));
    }

    match /managerialClassifications/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow create, update: if masterRestoreMode() || hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow delete: if masterRestoreMode() || hasRole(['master']);
    }

    match /accountingDispatches/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow create: if masterRestoreMode() || hasRole(['master', 'gerente', 'tesouraria']);
      allow update, delete: if masterRestoreMode() || hasRole(['master']);
    }

    match /accountingPackages/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow create: if masterRestoreMode();
      allow update, delete: if masterRestoreMode() || hasRole(['master']);
    }

    match /bankStatements/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow create, update: if masterRestoreMode() || hasRole(['master', 'gerente', 'tesouraria']);
      allow delete: if masterRestoreMode() || hasRole(['master', 'gerente', 'tesouraria']);
    }

    match /bankTransactions/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow create, update: if masterRestoreMode()
        || (
          hasRole(['master', 'gerente', 'tesouraria'])
          && bankPeriodOpen(request.resource.data.reconciliationPeriodId)
        );
      allow delete: if masterRestoreMode()
        || (
          isPrimaryAdminEmail()
          && hasRole(['master'])
          && bankPeriodOpen(resource.data.reconciliationPeriodId)
        );
    }

    match /bankReconciliations/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow create: if masterRestoreMode()
        || (
          hasRole(['master', 'gerente', 'tesouraria'])
          && bankPeriodOpen(request.resource.data.periodId)
        );
      allow delete: if masterRestoreMode()
        || (
          hasRole(['master', 'gerente', 'tesouraria'])
          && bankPeriodOpen(resource.data.periodId)
        );
      allow update: if masterRestoreMode();
    }

    match /bankReconciliationPeriods/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow create: if masterRestoreMode()
        || (
          hasRole(['master', 'gerente', 'tesouraria'])
          && request.resource.data.status == 'fechada'
        );
      allow update: if masterRestoreMode() || canCloseBankPeriod() || canReopenBankPeriod();
      allow delete: if masterRestoreMode();
    }

    match /auditLogs/{document=**} {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      // Cada registro precisa identificar o próprio autor; logs só saem na limpeza/restauração controlada.
      allow create: if masterRestoreMode()
        || (activeUser() && request.resource.data.userId == request.auth.uid);
      allow update: if masterRestoreMode();
      allow delete: if masterRestoreMode() || masterWipeMode();
    }

    match /settings/{document=**} {
      allow read: if activeUser();
      allow write: if masterRestoreMode() || hasRole(['master']);
    }

    match /appConfig/societaryTransfer {
      allow read: if hasRole(['master', 'diretor', 'gerente', 'tesouraria']);
      allow write: if masterRestoreMode() || societaryDecisionUser();
    }

    match /appConfig/{document=**} {
      allow read: if activeUser();
      allow write: if masterRestoreMode() || (isPrimaryAdminEmail() && hasRole(['master']));
    }
    // Metadados de PDF oficial: somente lançamentos finalizados, sem tocar
    // em valores, parcelas, status, fluxo de aprovação ou dados bancários.
    function officialPdfMetadataOnly(folder, documentId) {
      return hasRole(['master', 'diretor', 'gerente', 'tesouraria'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['demonstrative', 'demonstrativePath', 'demonstrativeUrl', 'demonstrativeGeneratedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['demonstrative', 'demonstrativePath', 'demonstrativeUrl'])
        && request.resource.data.demonstrative is map
        && request.resource.data.demonstrativePath is string
        && request.resource.data.demonstrativePath ==
           'demonstrativos/' + folder + '/' + documentId + '/' + (folder == 'despesas' ? 'v4' : 'v3') + '/demonstrativo.pdf'
        && request.resource.data.demonstrative.path == request.resource.data.demonstrativePath
        && request.resource.data.demonstrativeUrl is string
        && request.resource.data.demonstrative.url == request.resource.data.demonstrativeUrl
        && request.resource.data.demonstrativeGeneratedAt is string;
    }

    match /expenses/{documentId} {
      allow update: if resource.data.status in ['pago', 'arquivado']
        && officialPdfMetadataOnly('despesas', documentId);
    }

    match /receivables/{documentId} {
      allow update: if resource.data.status in ['recebido_tesouraria', 'encerrado']
        && officialPdfMetadataOnly('receitas', documentId);
    }

    match /alvaraTransfers/{documentId} {
      allow update: if resource.data.status in ['parcialmente_pago', 'pago']
        && officialPdfMetadataOnly('repasses-alvaras', documentId);
    }

    match /agentCommissions/{documentId} {
      allow update: if resource.data.status in ['parcialmente_pago', 'pago']
        && officialPdfMetadataOnly('comissoes', documentId);
    }

    match /societaryTransfers/{documentId} {
      allow update: if resource.data.status == 'pago'
        && officialPdfMetadataOnly('repasses-societarios', documentId);
    }

  }
}